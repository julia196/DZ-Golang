{
    "swagger": "2.0",
    "info": {
        "description": "API для загрузки фильмов с внешнего стенда.",
        "title": "Movie Service API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/last-movie": {
            "get": {
                "description": "Находит последний доступный фильм на стенде (бинарный поиск по id).",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "movies"
                ],
                "summary": "Последний фильм",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.Movie"
                        }
                    },
                    "404": {
                        "description": "Фильмов на стенде нет",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "502": {
                        "description": "Стенд недоступен",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "504": {
                        "description": "Таймаут стенда",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/load-movies": {
            "get": {
                "description": "Загружает фильмы со стенда в диапазоне [from; to]. Частичные ошибки возвращаются в полях missing_ids и failed_ids.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "movies"
                ],
                "summary": "Загрузка фильмов",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Начальный ID (\u003e= 1)",
                        "name": "from",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Конечный ID (\u003e= from)",
                        "name": "to",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.LoadResult"
                        }
                    },
                    "400": {
                        "description": "Неверные параметры from/to",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "502": {
                        "description": "Стенд недоступен",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "504": {
                        "description": "Таймаут стенда",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "main.FailedID": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer"
                },
                "reason": {
                    "type": "string"
                }
            }
        },
        "main.LoadResult": {
            "type": "object",
            "properties": {
                "failed_ids": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/main.FailedID"
                    }
                },
                "missing_ids": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "movies": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/main.Movie"
                    }
                }
            }
        },
        "main.Movie": {
            "type": "object",
            "properties": {
                "img": {
                    "type": "string"
                },
                "num": {
                    "type": "integer"
                },
                "title": {
                    "type": "string"
                }
            }
        }
    }
}